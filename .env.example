# Copy to .env.local and fill in. Expo loads it automatically; rebuild after changes.

# iOS OAuth client ID from Google Cloud Console (APIs & Services > Credentials).
# Enables "Google Drive" in Settings. Format: 1234567890-abc123.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Unique app identifier. Must match the Bundle ID entered for the Google iOS client.
# Example: com.yourname.pocketledger
APP_BUNDLE_ID=
